# Vorlage fuer .env.local  --  Kopie anlegen und Werte ersetzen:
#     cp .env.local.example .env.local && chmod 600 .env.local
#
# .env.local selbst gehoert NICHT ins Repository. Sie enthaelt pro Instanz
# eigene Zugangsdaten, Ports und Cookie-Namen.

# Leer lassen fuer SQLite, sonst PostgreSQL-Verbindung eintragen.
export DATABASE_URL='postgresql://BENUTZER:PASSWORT@127.0.0.1:5432/DATENBANK'

export PORT=5001

# Fest und lang setzen. Aendert sich der Wert, werden alle Sitzungen ungueltig.
export SECRET_KEY='hier-einen-langen-zufaelligen-wert-eintragen'

# Pro Instanz eigene Namen, sonst kollidieren mehrere Instanzen auf einem Host.
export SESSION_COOKIE_NAME='kompetenz_manager_session'
export REMEMBER_COOKIE_NAME='kompetenz_manager_remember'

# Migration explizit: python -m km_migrate
# Persönlicher Erstzugang ausschließlich am lokalen Terminal: python km_setup.py eigener.name
# Kein HTTP-Setup und keine Passwortausgabe.
# Proxyadressen ausdrücklich festlegen:
#export TRUSTED_PROXY_IPS='127.0.0.1'
